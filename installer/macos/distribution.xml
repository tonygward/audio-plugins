<?xml version="1.0" encoding="utf-8"?>
<!--
  Songsmith Plugins - one macOS installer for every plugin (productbuild distribution file).

  build-installer.sh fills in the versions and @MIN_MACOS@ and passes productbuild the component
  packages taken from each plugin's own .pkg (the same packages, not copies, so the two
  installers can't drift apart) and the resources/ folder.

  The Customize page shows one choice per plugin, all selected. Each choice installs everything
  that comes with the plugin:
    VST3 plugin    -> /Library/Audio/Plug-Ins/VST3/<plugin>.vst3
    Audio Unit     -> /Library/Audio/Plug-Ins/Components/<plugin>.component
    Standalone app -> /Applications/<plugin>.app
  The three packages sit inside the plugin's one choice (the Audio Analyzer is an app only, so its choice holds just the app, and the Plugin Analyzer is a VST3 only, so its choice holds just the VST3), so there are no separate format choices.

  The choice ids (eq, fet, max) are used by test-installer.sh (choice changes XML) and by anyone scripting an
  install, so keep them stable. The package ids are the per-plugin installers' ids (never change
  them): installing from either installer updates the same receipts, so there is one copy.
-->
<installer-gui-script minSpecVersion="2">
    <title>Songsmith Plugins @SUITE_VERSION@</title>
    <organization>com.songsmithstudio</organization>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <readme     file="readme.html"     mime-type="text/html"/>
    <license    file="licence.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Universal build. System-wide install only (admin password), into folders every host scans. -->
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <!-- The highest minimum of the three plugins (their deployment targets). -->
    <allowed-os-versions>
        <os-version min="@MIN_MACOS@"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="eq"/>
        <line choice="fet"/>
        <line choice="max"/>
        <line choice="comp"/>
        <line choice="opt"/>
        <line choice="peq"/>
        <line choice="bus"/>
        <line choice="desk"/>
        <line choice="pla"/>
        <line choice="ana"/>
    </choices-outline>

    <!-- Songsmith EQ -->
    <choice id="eq" title="Songsmith EQ @EQ_VERSION@" start_selected="true"
            description="Songsmith EQ: shape the tone of a track. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmitheq.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmitheq.au"/>
        <pkg-ref id="com.songsmithstudio.songsmitheq.app"/>
    </choice>

    <!-- Songsmith Analog Compressor -->
    <choice id="fet" title="Songsmith Analog Compressor @FET_VERSION@" start_selected="true"
            description="Songsmith Analog Compressor: even out the level and add analogue warmth. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.app"/>
    </choice>

    <!-- Songsmith Maximiser -->
    <choice id="max" title="Songsmith Maximiser @MAX_VERSION@" start_selected="true"
            description="Songsmith Maximiser: make a finished mix louder without clipping. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithmaximiser.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithmaximiser.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithmaximiser.app"/>
    </choice>

    <!-- Songsmith Compressor -->
    <choice id="comp" title="Songsmith Compressor @COMP_VERSION@" start_selected="true"
            description="Songsmith Compressor: even out the level with simple, clear controls. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithcompressor.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithcompressor.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithcompressor.app"/>
    </choice>

    <!-- Songsmith Passive EQ -->
    <choice id="peq" title="Songsmith Passive EQ @PEQ_VERSION@" start_selected="true"
            description="Songsmith Passive EQ: gentle, broad low and high tone shaping inspired by a classic passive equaliser. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.app"/>
    </choice>

    <!-- Songsmith Analog Desk -->
    <choice id="desk" title="Songsmith Analog Desk @DESK_VERSION@" start_selected="true"
            description="Songsmith Analog Desk: a mixing desk channel strip with filters, a four-band equaliser, a gate and a compressor in one plugin. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.app"/>
    </choice>

    <!-- Songsmith Bus Compressor -->
    <choice id="bus" title="Songsmith Bus Compressor @BUS_VERSION@" start_selected="true"
            description="Songsmith Bus Compressor: glues a mix or a group of sounds together, inspired by a classic mixing desk bus compressor. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.app"/>
    </choice>

    <!-- Songsmith Optical Leveller -->
    <choice id="opt" title="Songsmith Optical Leveller @OPT_VERSION@" start_selected="true"
            description="Songsmith Optical Leveller: smooth, simple levelling inspired by a classic optical unit. Installs the VST3 plugin, the Audio Unit (for Logic Pro and GarageBand) and a standalone app that runs without recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.vst3"/>
        <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.au"/>
        <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.app"/>
    </choice>

    <pkg-ref id="com.songsmithstudio.songsmitheq.vst3" version="@EQ_VERSION@" onConclusion="none">songsmitheq-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmitheq.au"   version="@EQ_VERSION@" onConclusion="none">songsmitheq-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmitheq.app"  version="@EQ_VERSION@" onConclusion="none">songsmitheq-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.vst3" version="@FET_VERSION@" onConclusion="none">songsmithanalogcompressor-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.au"   version="@FET_VERSION@" onConclusion="none">songsmithanalogcompressor-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithanalogcompressor.app"  version="@FET_VERSION@" onConclusion="none">songsmithanalogcompressor-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithmaximiser.vst3" version="@MAX_VERSION@" onConclusion="none">songsmithmaximiser-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithmaximiser.au"   version="@MAX_VERSION@" onConclusion="none">songsmithmaximiser-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithmaximiser.app"  version="@MAX_VERSION@" onConclusion="none">songsmithmaximiser-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithcompressor.vst3" version="@COMP_VERSION@" onConclusion="none">songsmithcompressor-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.vst3" version="@OPT_VERSION@" onConclusion="none">songsmithopticalleveller-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.au"   version="@OPT_VERSION@" onConclusion="none">songsmithopticalleveller-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithopticalleveller.app"  version="@OPT_VERSION@" onConclusion="none">songsmithopticalleveller-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.vst3" version="@PEQ_VERSION@" onConclusion="none">songsmithpassiveeq-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.au"   version="@PEQ_VERSION@" onConclusion="none">songsmithpassiveeq-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithpassiveeq.app"  version="@PEQ_VERSION@" onConclusion="none">songsmithpassiveeq-app.pkg</pkg-ref>
    <!-- Songsmith Plugin Analyzer: a VST3 plugin only (no Audio Unit and no app), for measuring what another plugin does -->
    <choice id="pla" title="Songsmith Plugin Analyzer @PLA_VERSION@" start_selected="true"
            description="Songsmith Plugin Analyzer: measure what another plugin does to the sound at each frequency. Installs the VST3 plugin only: put one copy before the plugin you want to measure and one after it.">
        <pkg-ref id="com.songsmithstudio.songsmithpluginanalyzer.vst3"/>
    </choice>

    <!-- Songsmith Audio Analyzer: an application only (no VST3 and no Audio Unit), for checking a finished song -->
    <choice id="ana" title="Songsmith Audio Analyzer @ANA_VERSION@" start_selected="true"
            description="Songsmith Audio Analyzer: check the loudness and format of a finished song. Installs one app in Applications. It is not a plugin and needs no recording software.">
        <pkg-ref id="com.songsmithstudio.songsmithaudioanalyzer.app"/>
    </choice>

    <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.vst3" version="@DESK_VERSION@" onConclusion="none">songsmithanalogdesk-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.au"   version="@DESK_VERSION@" onConclusion="none">songsmithanalogdesk-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithanalogdesk.app"  version="@DESK_VERSION@" onConclusion="none">songsmithanalogdesk-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.vst3" version="@BUS_VERSION@" onConclusion="none">songsmithbuscompressor-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.au"   version="@BUS_VERSION@" onConclusion="none">songsmithbuscompressor-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithbuscompressor.app"  version="@BUS_VERSION@" onConclusion="none">songsmithbuscompressor-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithpluginanalyzer.vst3" version="@PLA_VERSION@" onConclusion="none">songsmithpluginanalyzer-vst3.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithaudioanalyzer.app"  version="@ANA_VERSION@" onConclusion="none">songsmithaudioanalyzer-app.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithcompressor.au"   version="@COMP_VERSION@" onConclusion="none">songsmithcompressor-au.pkg</pkg-ref>
    <pkg-ref id="com.songsmithstudio.songsmithcompressor.app"  version="@COMP_VERSION@" onConclusion="none">songsmithcompressor-app.pkg</pkg-ref>
</installer-gui-script>
